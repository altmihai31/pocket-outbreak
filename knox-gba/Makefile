#---------------------------------------------------------------------------------------------------------------------
# Knox-style survival for GBA. Based on Butano's template Makefile; see ../butano/template/Makefile for
# the meaning of every variable.
#
#   make -j               normal ROM (knox.gba)
#   make -j PROFILE=1     profiler build (knox_profile.gba): L+Start in game shows bn::profiler results
#   make -j DEBUG=1       tester build (knox_debug.gba): CPU readout on, asserts show a stack trace
#   make -j BENCH=1       scripted benchmark route; per-system timings go to mGBA's debug log (knox_bench.gba)
#   make -j BENCH=2       scripted one-on-one duel that logs the fight (knox_duel.gba)
#   make -j BENCH=3       scripted search of two kitchen cabinets and the gear menu (knox_loot.gba)
#   make -j BENCH=4       scripted deaths and restarts (knox_restart.gba)
#   make -j BENCH=5       a crawler comes in while the player swings at it (knox_crawler.gba)
#   make -j BENCH=6       fast-time survival: bleed, bandage, eat, sleep, die of infection (knox_survival.gba)
#   make -j BENCH=7       sprint across a generated world (fixed seed), then dump the macro map and the chunk
#                         cache (tools/render_world_dump.py) (knox_travel.gba)
#   make -j BENCH=8       save a generated world, quit, load it and compare (knox_save.gba)
#   make -j BENCH=9       vehicles on the test map: fix and drive the car, ride the bicycle (knox_vehicles.gba)
#   make -j BENCH=13      the wild (milestone 13): swimming, drowning, a heavy load at the river (knox_wild.gba)
#   make -j BENCH=14      towns (milestone 14): the loot census of every building on the fixed seed (knox_towns.gba)
#   make -j BENCH=15      animals (animals plan): a boar walks off, charges, is shot and butchered (knox_animals.gba)
#   make -j BENCH=16      animal census (animals plan stage 7): a wild cell and a farm by day and night, then the
#                         worst cases; counts, sprites and frame times (knox_census.gba)
#   make -j BENCH=n DUMP=1  the same bench, logging the HUD layer every 20 frames (tools/render_hud_dump.py)
#   make -j BENCH=n CHECK=1 the same bench, checking the world renderer's visible cells every 30 frames
#
# Graphics are generated by tools/gen_assets.py (run automatically through EXTTOOL).
#---------------------------------------------------------------------------------------------------------------------
TARGET      	:=  knox
BUILD       	:=  build
LIBBUTANO   	:=  ../butano/butano
PYTHON      	:=  python
SOURCES     	:=  src
INCLUDES    	:=  include ../butano/common/include
DATA        	:=
GRAPHICS    	:=  graphics
AUDIO       	:=  audio
AUDIOBACKEND	:=  maxmod
AUDIOTOOL		:=
DMGAUDIO    	:=  dmg_audio
DMGAUDIOBACKEND	:=  default
ROMTITLE    	:=  POCKETOUTBRK
ROMCODE     	:=  KNXE
USERFLAGS   	:=  -DBN_CFG_SPRITES_MAX_SORT_LAYERS=32 -DBN_CFG_AUDIO_MAX_SOUND_CHANNELS=6
USERCXXFLAGS	:=
USERASFLAGS 	:=
USERLDFLAGS 	:=
USERLIBDIRS 	:=
USERLIBS    	:=
DEFAULTLIBS 	:=
STACKTRACE		:=
USERBUILD   	:=  build_profile build_debug build_bench build_duel build_loot build_restart build_crawler build_survival build_travel \
                build_save build_vehicles \
                $(wildcard build_*_dump)
EXTTOOL     	:=  $(PYTHON) tools/gen_assets.py

ifeq ($(PROFILE),1)
	TARGET		:=  knox_profile
	BUILD		:=  build_profile
	USERFLAGS	+=  -DBN_CFG_PROFILER_ENABLED=true
endif

ifeq ($(BENCH),1)
	TARGET		:=  knox_bench
	BUILD		:=  build_bench
	USERFLAGS	+=  -DKX_BENCH=1
endif

ifeq ($(BENCH),2)
	TARGET		:=  knox_duel
	BUILD		:=  build_duel
	USERFLAGS	+=  -DKX_BENCH=2
endif

ifeq ($(BENCH),3)
	TARGET		:=  knox_loot
	BUILD		:=  build_loot
	USERFLAGS	+=  -DKX_BENCH=3
endif

ifeq ($(BENCH),6)
	TARGET		:=  knox_survival
	BUILD		:=  build_survival
	USERFLAGS	+=  -DKX_BENCH=6
endif

ifeq ($(BENCH),5)
	TARGET		:=  knox_crawler
	BUILD		:=  build_crawler
	USERFLAGS	+=  -DKX_BENCH=5
endif

ifeq ($(BENCH),8)
	TARGET		:=  knox_save
	BUILD		:=  build_save
	USERFLAGS	+=  -DKX_BENCH=8
endif

ifeq ($(BENCH),9)
	TARGET		:=  knox_vehicles
	BUILD		:=  build_vehicles
	USERFLAGS	+=  -DKX_BENCH=9
endif

ifeq ($(BENCH),10)
	TARGET		:=  knox_night
	BUILD		:=  build_night
	USERFLAGS	+=  -DKX_BENCH=10
endif

ifeq ($(BENCH),11)
	TARGET		:=  knox_guns
	BUILD		:=  build_guns
	USERFLAGS	+=  -DKX_BENCH=11
endif

ifeq ($(BENCH),13)
	TARGET		:=  knox_wild
	BUILD		:=  build_wild
	USERFLAGS	+=  -DKX_BENCH=13
endif

ifeq ($(BENCH),16)
	TARGET		:=  knox_census
	BUILD		:=  build_census
	USERFLAGS	+=  -DKX_BENCH=16
endif

ifeq ($(BENCH),15)
	TARGET		:=  knox_animals
	BUILD		:=  build_animals
	USERFLAGS	+=  -DKX_BENCH=15
endif

ifeq ($(BENCH),14)
	TARGET		:=  knox_towns
	BUILD		:=  build_towns
	USERFLAGS	+=  -DKX_BENCH=14
endif

ifeq ($(BENCH),12)
	TARGET		:=  knox_doors
	BUILD		:=  build_doors
	USERFLAGS	+=  -DKX_BENCH=12
endif

ifeq ($(BENCH),7)
	TARGET		:=  knox_travel
	BUILD		:=  build_travel
	USERFLAGS	+=  -DKX_BENCH=7
endif

ifeq ($(BENCH),4)
	TARGET		:=  knox_restart
	BUILD		:=  build_restart
	USERFLAGS	+=  -DKX_BENCH=4
endif

# DEBUG=1: the full game for testers: CPU readout on from the start, "DEBUG BUILD" on the title, asserts with a stack
# trace on screen.
ifeq ($(DEBUG),1)
	TARGET		:=  knox_debug
	BUILD		:=  build_debug
	STACKTRACE	:=  true
	USERFLAGS	+=  -DKX_DEBUG=1
endif

# DUMP=1 (with a BENCH value): log the HUD layer every 20 frames for tools/render_hud_dump.py.
ifeq ($(DUMP),1)
	TARGET		:=  $(TARGET)_dump
	BUILD		:=  $(BUILD)_dump
	USERFLAGS	+=  -DKX_DUMP=1
endif

# CHECK=1 (with a BENCH value; milestone 14): every 30 frames the world renderer's visible cells are worked out again
# and compared with VRAM (KXRENDER lines). Costs frames, so its timings don't count.
ifeq ($(CHECK),1)
	TARGET		:=  $(TARGET)_check
	BUILD		:=  $(BUILD)_check
	USERFLAGS	+=  -DKX_RENDER_CHECK=1
endif

#---------------------------------------------------------------------------------------------------------------------
# Export absolute butano path:
#---------------------------------------------------------------------------------------------------------------------
ifndef LIBBUTANOABS
	export LIBBUTANOABS	:=	$(realpath $(LIBBUTANO))
endif

#---------------------------------------------------------------------------------------------------------------------
# Include main makefile:
#---------------------------------------------------------------------------------------------------------------------
include $(LIBBUTANOABS)/butano.mak
